{
  "name": "market-radar",
  "productName": "Market Radar",
  "version": "1.8.3",
  "description": "Reads market, earnings, analyst and macro/forex news and ranks stocks with bullish and bearish catalysts.",
  "main": "main.js",
  "author": "Jake",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "release": "node scripts/release.js",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win --x64",
    "dist": "electron-builder --mac --win",
    "stats": "node scripts/stats.js"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "24.13.3",
    "lightweight-charts": "^4.2.3"
  },
  "build": {
    "appId": "com.jake.marketradar",
    "productName": "Market Radar",
    "files": [
      "main.js",
      "app-main.js",
      "cloud.json",
      "preload.js",
      "engine/**",
      "renderer/**",
      "RESEARCH.md",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.finance",
      "icon": "build/icon.png",
      "identity": null,
      "hardenedRuntime": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Market-Radar-Setup-${version}-x64.exe"
    },
    "dmg": {
      "artifactName": "Market-Radar-${version}-${arch}.dmg"
    },
    "publish": null,
    "afterPack": "build/adhoc-sign.js"
  },
  "repository": "https://github.com/Jdog1234/market-radar"
}
