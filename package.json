{
  "name": "market-radar",
  "productName": "Market Radar",
  "version": "1.0.0",
  "description": "Reads market, earnings, analyst and macro/forex news and ranks stocks with bullish and bearish catalysts.",
  "main": "main.js",
  "author": "Jake",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "scan": "node scripts/cli-scan.js",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win --x64",
    "dist": "electron-builder --mac --win"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "com.jake.marketradar",
    "productName": "Market Radar",
    "files": ["main.js", "preload.js", "engine/**", "renderer/**", "RESEARCH.md", "package.json"],
    "directories": { "output": "dist", "buildResources": "build" },
    "mac": {
      "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }],
      "category": "public.app-category.finance",
      "icon": "build/icon.png"
    },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }, { "target": "portable", "arch": ["x64"] }],
      "icon": "build/icon.png"
    },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "artifactName": "Market-Radar-Setup-${version}-x64.exe" },
    "portable": { "artifactName": "Market-Radar-Portable-${version}-x64.exe" },
    "dmg": { "artifactName": "Market-Radar-${version}-${arch}.dmg" }
  }
}
